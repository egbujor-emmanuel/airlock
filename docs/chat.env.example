# Copy to .secrets/chat.env and fill in. Never commit the filled-in file.

# Discord Developer Portal > your app > Bot > Reset Token
DISCORD_BOT_TOKEN=

# Discord: right-click your server icon > Copy Server ID (turn on Developer Mode first)
DISCORD_SERVER_ID=

# The token @BotFather gives you
TELEGRAM_BOT_TOKEN=

# Your bot's username, e.g. airlock_demo_bot
TELEGRAM_BOT_USERNAME=
